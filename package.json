{
  "name": "n2-goi-flashcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/app.css --minify",
    "build": "npm run build:data && npm run build:icons && npm run build:css",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
